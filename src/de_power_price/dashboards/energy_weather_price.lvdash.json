{
  "datasets": [
    {
      "name": "negative_prices",
      "displayName": "Most Negative Prices (Top 20)",
      "config": {
        "version": "1.1",
        "source": "SELECT timestamp_utc, day_ahead_price, renewable_share_of_generation, wind_speed, cloud_cover FROM de_power_price.prod_gold.negative_prices ORDER BY day_ahead_price ASC LIMIT 20\n",
        "dimensions": [
          {
            "name": "timestamp_utc",
            "expr": "timestamp_utc",
            "displayName": "Timestamp (UTC)",
            "format": {
              "type": "date_time",
              "dateFormat": "year_month_day",
              "timeFormat": "locale_hour_minute"
            }
          },
          {
            "name": "day_ahead_price",
            "expr": "day_ahead_price",
            "displayName": "Day-Ahead Price (EUR/MWh)"
          },
          {
            "name": "renewable_share_of_generation",
            "expr": "renewable_share_of_generation",
            "displayName": "Renewable Share of Generation"
          },
          {
            "name": "wind_speed",
            "expr": "wind_speed",
            "displayName": "Wind Speed (m/s)"
          },
          {
            "name": "cloud_cover",
            "expr": "cloud_cover",
            "displayName": "Cloud Cover"
          }
        ]
      }
    },
    {
      "name": "energy_weather",
      "displayName": "Energy Weather Price",
      "config": {
        "version": "1.1",
        "source": "de_power_price.prod_gold.energy_weather_price",
        "dimensions": [
          {
            "name": "timestamp_utc",
            "expr": "timestamp_utc",
            "displayName": "Timestamp (UTC)",
            "format": {
              "type": "date_time",
              "dateFormat": "year_month_day",
              "timeFormat": "locale_hour_minute"
            }
          },
          {
            "name": "hour_of_day",
            "expr": "HOUR(timestamp_utc)",
            "displayName": "Hour of Day"
          },
          {
            "name": "day_ahead_price",
            "expr": "day_ahead_price",
            "displayName": "Day-Ahead Price (EUR/MWh)"
          },
          {
            "name": "wind_onshore",
            "expr": "wind_onshore",
            "displayName": "Wind Onshore (MW)"
          },
          {
            "name": "wind_offshore",
            "expr": "wind_offshore",
            "displayName": "Wind Offshore (MW)"
          },
          {
            "name": "solar",
            "expr": "solar",
            "displayName": "Solar (MW)"
          },
          {
            "name": "renewable_share_of_generation",
            "expr": "renewable_share_of_generation",
            "displayName": "Renewable Share of Generation"
          },
          {
            "name": "wind_speed",
            "expr": "wind_speed",
            "displayName": "Wind Speed (m/s)"
          },
          {
            "name": "cloud_cover",
            "expr": "cloud_cover",
            "displayName": "Cloud Cover"
          },
          {
            "name": "temperature",
            "expr": "temperature",
            "displayName": "Temperature (C)"
          }
        ],
        "measures": [
          {
            "name": "avg_price",
            "expr": "AVG(day_ahead_price)",
            "displayName": "Avg Day-Ahead Price"
          },
          {
            "name": "min_price",
            "expr": "MIN(day_ahead_price)",
            "displayName": "Min Day-Ahead Price"
          },
          {
            "name": "neg_price_pct",
            "expr": "SUM(CASE WHEN day_ahead_price < 0 THEN 1 ELSE 0 END) / COUNT(1)",
            "displayName": "Negative Price Pct",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
  ],
